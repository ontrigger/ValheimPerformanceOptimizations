<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Library</OutputType>
        <RootNamespace>ValheimPerformanceOptimizations</RootNamespace>
        <AssemblyName>ValheimPerformanceOptimizations</AssemblyName>
        <TargetFramework>netstandard2.1</TargetFramework>
        <LangVersion>latest</LangVersion>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <Import Project="..\Environment.props" />

    <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
        <DefineConstants>DEBUG;TRACE;ENABLE_PROFILER;_DEBUG;UNITY_ASSERTIONS</DefineConstants>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <DefineConstants>TRACE</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all"/>
        <PackageReference Include="BepInEx.Core" Version="5.*" />
        <PackageReference Include="BepInEx.PluginInfoProps" Version="1.*"/>
        <PackageReference Include="UnityEngine.Modules" Version="6000.0.61" >
            <IncludeAssets>all</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.3" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <Reference Include="0Harmony, Culture=neutral, PublicKeyToken=null">
            <HintPath>$(VALHEIM_INSTALL)\BepInEx\core\0Harmony.dll</HintPath>
        </Reference>
        <Reference Include="assembly_guiutils" Publicize="true">
            <HintPath>$(VALHEIM_INSTALL)\valheim_Data\Managed\assembly_guiutils.dll</HintPath>
        </Reference>
        <Reference Include="assembly_utils" Publicize="true">
            <HintPath>$(VALHEIM_INSTALL)\valheim_Data\Managed\assembly_utils.dll</HintPath>
        </Reference>
        <Reference Include="assembly_valheim" Publicize="true">
            <HintPath>$(VALHEIM_INSTALL)\valheim_Data\Managed\assembly_valheim.dll</HintPath>
        </Reference>
        <Reference Include="Jotunn, Culture=neutral, PublicKeyToken=null">
            <HintPath Condition="Exists('$(VALHEIM_INSTALL)\BepInEx\plugins\Jotunn.dll')">$(VALHEIM_INSTALL)\BepInEx\plugins\Jotunn.dll</HintPath>
            <HintPath Condition="Exists('$(R2MODMAN_INSTALL)\BepInEx\plugins\ValheimModding-Jotunn\Jotunn.dll')">$(R2MODMAN_INSTALL)\BepInEx\plugins\ValheimModding-Jotunn\Jotunn.dll</HintPath>
        </Reference>
        <Reference Include="Unity.Mathematics">
            <HintPath>$(VALHEIM_INSTALL)\valheim_Data\Managed\Unity.Mathematics.dll</HintPath>
        </Reference>
        <Reference Include="UnityEngine.UI, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null">
            <HintPath>$(VALHEIM_INSTALL)\unstripped_corlib\UnityEngine.UI.dll</HintPath>
        </Reference>
        <Reference Include="ValheimPerformanceOptimizations.Burst">
            <HintPath>BurstOutput\ValheimPerformanceOptimizations.Burst.dll</HintPath>
            <Private>true</Private>
        </Reference>
        <Reference Include="Unity.Burst">
            <HintPath>BurstOutput\Unity.Burst.dll</HintPath>
            <Private>true</Private>
        </Reference>
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\IndirectRendering\IndirectRendering.csproj" />
    </ItemGroup>
    <ItemGroup>
        <EmbeddedResource Include="AssetBundles\piece_shader" />
    </ItemGroup>
    <ItemGroup>
        <Compile Remove="Patches\Water\WaterVolumeVisibilityPatch.cs" />

    </ItemGroup>
    <ItemGroup>
        <None Include="BurstOutput\ValheimPerformanceOptimizations.Burst_win_x86_64.dll" Condition="Exists('BurstOutput\ValheimPerformanceOptimizations.Burst_win_x86_64.dll')">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <Link>ValheimPerformanceOptimizations.Burst_win_x86_64.dll</Link>
        </None>
        <None Include="BurstOutput\ValheimPerformanceOptimizations.Burst_linux_x86_64.so" Condition="Exists('BurstOutput\ValheimPerformanceOptimizations.Burst_linux_x86_64.so')">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <Link>ValheimPerformanceOptimizations.Burst_linux_x86_64.so</Link>
        </None>
        <None Include="BurstOutput\Unity.Burst.Unsafe.dll" Condition="Exists('BurstOutput\Unity.Burst.Unsafe.dll')">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <Link>Unity.Burst.Unsafe.dll</Link>
        </None>
    </ItemGroup>
    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <PostBuildEvent>
            if exist "$(MSBuildProjectDirectory)\Package" if not exist "$(MSBuildProjectDirectory)\PublishOutput" mkdir "$(MSBuildProjectDirectory)\PublishOutput"
            if exist "$(MSBuildProjectDirectory)\Package" powershell -NoProfile -Command "Compress-Archive -Path '$(MSBuildProjectDirectory)\Package\*' -DestinationPath '$(MSBuildProjectDirectory)\PublishOutput\$(MSBuildProjectName).zip' -Force"
        </PostBuildEvent>
    </PropertyGroup>

    <Target Name="CopyToPlugins" AfterTargets="Build" Condition="'$(Configuration)' == 'Release' And '$(VALHEIM_INSTALL)' != ''">
        <ItemGroup>
            <PluginFile Include="$(OutDir)$(AssemblyName).dll" />
            <PluginFile Include="$(OutDir)$(AssemblyName).pdb" />
            <PluginFile Include="$(OutDir)ValheimPerformanceOptimizations.Burst.dll" />
            <PluginFile Include="$(OutDir)ValheimPerformanceOptimizations.Burst_win_x86_64.dll" />
            <PluginFile Include="$(OutDir)ValheimPerformanceOptimizations.Burst_linux_x86_64.so" />
            <PluginFile Include="$(OutDir)IndirectRendering.dll" />
            <PluginFile Include="$(OutDir)IndirectRendering.pdb" />
            <PluginFile Include="$(OutDir)IndirectRendering.Burst.dll" />
            <PluginFile Include="$(OutDir)IndirectRendering.Burst_win_x86_64.dll" />
            <PluginFile Include="$(OutDir)IndirectRendering.Burst_linux_x86_64.so" />
        </ItemGroup>
        <Copy SourceFiles="@(PluginFile)" DestinationFolder="$(VALHEIM_INSTALL)\BepInEx\plugins\VPO" Condition="Exists('%(FullPath)')" SkipUnchangedFiles="true" />
    </Target>
</Project>
